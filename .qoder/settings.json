{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .qoder/hooks/pr_evidence.py",
            "if": "Bash(gh pr create:*)",
            "name": "pr-evidence-gate",
            "statusMessage": "校验 PR 三段证据",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
